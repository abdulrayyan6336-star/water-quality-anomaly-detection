# Application Settings
PROJECT_NAME="Water Quality Anomaly Detection & Smart Sampling Prioritizer"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api"

# MySQL Database Configuration
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql+pymysql://root:password123@localhost:3306/water_quality_db"
# Fallback SQLite DB URL if MySQL is not available:
SQLITE_FALLBACK_URL="sqlite:///./water_quality.db"

# JWT Authentication
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Isolation Forest Model Configuration
MODEL_PATH="backend/ml/isolation_forest_model.joblib"
SCALER_PATH="backend/ml/scaler.joblib"
CONTAMINATION_RATE=0.08
RANDOM_STATE=42

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
